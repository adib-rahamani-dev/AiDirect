generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Legacy connection/delivery proof remains single-operator; catalog tenancy is separate.
model ProofConnection {
  id                  String   @id @default("proof")
  accountId           String   @unique
  appScopedId         String
  username            String
  tokenCipher         String
  expiresAt           DateTime
  issuedAt            DateTime @default(now())
  acceptCommentsSince DateTime @default(now())
  status              String   @default("connected")
  subscribed          Boolean  @default(false)
  nextSendAt          DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ProofRule {
  id        String   @id @default("proof")
  accountId String
  mediaId   String
  keyword   String
  replyText String
  link      String
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model CommentEvent {
  id         String     @id @default(cuid())
  accountId  String
  commentId  String
  mediaId    String
  source     String
  matched    Boolean
  receivedAt DateTime   @default(now())
  deliveries Delivery[]

  @@unique([accountId, commentId, source])
}

model Delivery {
  id            String       @id @default(cuid())
  eventId       String
  event         CommentEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  accountId     String
  commentId     String
  mediaId       String
  provider      String
  source        String
  replyCipher   String
  status        String       @default("pending")
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  leaseUntil    DateTime?
  leaseToken    String?
  messageId     String?
  errorKind     String?
  errorCode     Int?
  errorSubcode  Int?
  traceId       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  observedAt    DateTime?

  // Global per account/comment/provider, survives disconnect and reconnect.
  @@unique([accountId, commentId, provider])
  @@index([status, nextAttemptAt])
}

model OAuthAttempt {
  stateHash  String   @id
  inviteHash String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model ConnectionInvite {
  tokenHash String    @id
  expiresAt DateTime
  claimedAt DateTime?
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model ProofLoginGuard {
  id            String   @id
  nextAttemptAt DateTime
}

model OperatorSession {
  tokenHash String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model WorkerState {
  id         String   @id
  lastSeenAt DateTime
  provider   String
}

// Provider-specific proof stays isolated from the direct Meta adapter.
model SendboxConnection {
  id          String   @id @default("proof")
  accountId   String   @unique
  instagramId String
  username    String
  expiresAt   DateTime
  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  dmSettings  SendboxDmSettings?
  dmContexts  SendboxDmContext[]
}

// Short-lived encrypted evidence; receiving an action result is not proof of delivery.
model SendboxWebhookEvent {
  eventId       String   @id
  accountId     String
  eventType     String
  payloadCipher String?
  receivedAt    DateTime @default(now())
  expiresAt     DateTime

  @@index([expiresAt])
}

// Owner connection grant only; never an operator session or provider credential.
model SendboxInvite {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  claimHash String?
  expiresAt DateTime
  claimedAt DateTime?
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

// Catalog tenancy is independent of the legacy, single-operator connection proof.
model User {
  id          String       @id @default(cuid())
  name        String       @default("")
  email       String?      @unique
  emailVerified Boolean    @default(false)
  image       String?
  platformRole PlatformRole @default(CUSTOMER)
  suspended   Boolean      @default(false)
  updatedAt   DateTime     @default(now()) @updatedAt
  memberships Membership[]
  sessions    Session[]
  accounts    Account[]
  ownedWorkspace Workspace? @relation("WorkspaceOwner")
  createdAt   DateTime     @default(now())
}

enum PlatformRole {
  CUSTOMER
  SENIOR_ADMIN
}

model Workspace {
  id          String        @id @default(cuid())
  name        String
  paused      Boolean       @default(false)
  ownerId     String?       @unique
  owner       User?         @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  memberships Membership[]
  pages       CatalogPage[]
  instagram   InstagramConnection?
  instagramOAuth InstagramOAuthAttempt[]
  createdAt   DateTime      @default(now())
}

// Direct Meta integration: each connection and every child row belong to one workspace.
model InstagramConnection {
  id String @id @default(cuid())
  workspaceId String @unique
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  accountId String @unique
  appScopedId String
  username String
  tokenCipher String
  status String @default("connected")
  subscribed Boolean @default(false)
  errorKind String?
  issuedAt DateTime @default(now())
  expiresAt DateTime
  acceptSince DateTime @default(now())
  autoDm Boolean @default(false)
  assistantConfig Json?
  historyCursorCipher String?
  historyHasMore Boolean @default(true)
  historySyncedAt DateTime?
  historyLeaseToken String?
  historyLeaseUntil DateTime?
  tone String @default("friendly")
  shippingPolicy String @default("")
  shorthandMillions Boolean @default(false)
  settingsRevision String @default(cuid())
  nextSendAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  automations InstagramAutomation[]
  threads InstagramThread[]
  jobs InstagramJob[]
  envelopes InstagramWebhookEnvelope[]
  @@unique([id, workspaceId])
}

model InstagramWebhookEnvelope {
  id String @id
  workspaceId String
  connectionId String
  connection InstagramConnection @relation(fields: [connectionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  payloadCipher String?
  status String @default("pending")
  attempts Int @default(0)
  startedAt DateTime?
  receivedAt DateTime @default(now())
  expiresAt DateTime
  @@index([status, receivedAt])
}

model InstagramOAuthAttempt {
  stateHash String @id
  workspaceId String
  userId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  @@index([expiresAt])
}

model InstagramAutomation {
  id String @id @default(cuid())
  workspaceId String
  connectionId String
  connection InstagramConnection @relation(fields: [connectionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  mediaId String
  keyword String
  replyText String
  link String
  enabled Boolean @default(false)
  revision String @default(cuid())
  updatedAt DateTime @updatedAt
  @@unique([connectionId, mediaId, keyword])
  @@index([workspaceId])
}

model InstagramThread {
  id String @id
  workspaceId String
  connectionId String
  connection InstagramConnection @relation(fields: [connectionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  senderCipher String
  contactUsername String?
  remoteIdCipher String?
  historySyncedAt DateTime?
  starred Boolean @default(false)
  archived Boolean @default(false)
  lastReadAt DateTime?
  noteCipher String?
  lastInboundAt DateTime
  lastMessageAt DateTime
  handedOff Boolean @default(false)
  contextCipher String?
  contextAt DateTime?
  lastProcessedInboundAt DateTime?
  leaseToken String?
  leaseUntil DateTime?
  messages InstagramMessage[]
  jobs InstagramJob[]
  @@unique([id, workspaceId])
  @@index([workspaceId, lastMessageAt])
  @@index([workspaceId, archived, lastMessageAt])
}

model InstagramMessage {
  id String @id
  workspaceId String
  threadId String
  thread InstagramThread @relation(fields: [threadId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  direction String
  textCipher String?
  intent String @default("unclassified")
  source String @default("webhook")
  receivedAt DateTime @default(now())
  expiresAt DateTime
  @@index([workspaceId, threadId, receivedAt])
  @@index([expiresAt])
}

model InstagramJob {
  id String @id @default(cuid())
  dedupeKey String @unique
  workspaceId String
  connectionId String
  connection InstagramConnection @relation(fields: [connectionId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  threadId String?
  thread InstagramThread? @relation(fields: [threadId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  kind String
  automationId String?
  revision String?
  payloadCipher String?
  status String @default("pending")
  attempts Int @default(0)
  leaseToken String?
  leaseUntil DateTime?
  nextAttemptAt DateTime @default(now())
  expiresAt DateTime
  errorKind String?
  messageId String?
  intent String @default("unclassified")
  resultKind String?
  interpretation String @default("none")
  aiAttempted Boolean @default(false)
  aiSucceeded Boolean @default(false)
  budgetBucket String?
  responseMs Int?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([status, nextAttemptAt])
  @@index([workspaceId, createdAt])
}

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

model Membership {
  userId      String
  workspaceId String
  role        WorkspaceRole
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
}

// A manually named catalog page is NOT an authenticated Instagram connection.
model CatalogPage {
  id          String           @id @default(cuid())
  workspaceId String
  name        String
  handle      String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  products    CatalogProduct[]
  createdAt   DateTime         @default(now())
  dmSettings  SendboxDmSettings[]
  dmContexts  SendboxDmContext[]

  @@unique([id, workspaceId])
  @@unique([workspaceId, handle])
}

model CatalogProduct {
  id          String          @id @default(cuid())
  workspaceId String
  pageId      String
  name        String
  description String
  category    String
  priceToman  BigInt
  stock       Int
  active      Boolean         @default(true)
  url         String
  page        CatalogPage     @relation(fields: [pageId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  posts       MediaProduct[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([id, workspaceId, pageId])
  @@index([workspaceId, pageId, active, priceToman])
}

model MediaProduct {
  id          String         @id @default(cuid())
  workspaceId String
  pageId      String
  productId   String
  permalink   String
  product     CatalogProduct @relation(fields: [productId, workspaceId, pageId], references: [id, workspaceId, pageId], onDelete: Cascade)

  // Manual associations are for preview only until provider ownership is verified.
  @@unique([workspaceId, pageId, productId, permalink])
}

model OperationControl {
  id        String   @id @default("proof")
  paused    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// Better Auth core models. Instagram credentials remain in their separate adapter.
model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model Account {
  id                    String   @id
  accountId             String
  providerId            String
  userId                String
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@index([identifier])
}

model AuthThrottle {
  key       String @id
  count     Int
  expiresAt DateTime
  @@index([expiresAt])
}

model AdminAudit {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  targetId  String
  detail    String
  createdAt DateTime @default(now())
  @@index([createdAt])
}

// Limited owner-operated DM pilot; not customer Instagram tenancy.
model SendboxDmSettings {
  accountId    String @id
  connection   SendboxConnection @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  workspaceId  String
  pageId       String
  page         CatalogPage @relation(fields: [pageId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  enabled      Boolean @default(false)
  shorthandMillions Boolean @default(false)
  tone          String @default("friendly")
  shippingPolicy String @default("")
  aiEnabled     Boolean @default(false)
  revision     String
  enabledSince DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SendboxDmDelivery {
  id            String @id @default(cuid())
  accountId     String
  messageHash   String
  senderHash    String
  revision      String
  payloadCipher String?
  status        String @default("pending")
  errorKind     String?
  attempts      Int @default(0)
  leaseToken    String?
  leaseUntil    DateTime?
  nextAttemptAt DateTime @default(now())
  receivedAt    DateTime @default(now())
  inboundAt     DateTime
  expiresAt     DateTime
  updatedAt     DateTime @updatedAt
  intent        String @default("unclassified")
  resultKind    String?
  interpretation String @default("none")
  aiAttempted   Boolean @default(false)
  aiSucceeded   Boolean @default(false)
  budgetBucket  String?
  selectedProductIds Json @default("[]")
  analyzedAt    DateTime?
  responseMs    Int?

  @@unique([accountId, messageHash])
  @@index([status, nextAttemptAt])
  @@index([expiresAt])
  @@index([accountId, senderHash, receivedAt])
}

// No raw chat history; only short-lived encrypted shopping context and per-sender lease.
model SendboxDmContext {
  accountId    String
  connection   SendboxConnection @relation(fields: [accountId], references: [accountId], onDelete: Cascade)
  senderHash   String
  workspaceId  String
  pageId       String
  page         CatalogPage @relation(fields: [pageId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  revision     String
  stateCipher  String?
  handedOff    Boolean @default(false)
  lastInboundAt DateTime?
  expiresAt    DateTime
  leaseToken   String?
  leaseUntil   DateTime?
  updatedAt    DateTime @updatedAt

  @@id([accountId, senderHash])
  @@index([expiresAt])
}
