# No real credentials belong in this file. Run npm run setup:local.
APP_BASE_URL=http://localhost:3000
# Public canonical HTTPS origin, independent of local/OAuth testing URLs.
SITE_URL=https://aidirect-kappa.vercel.app
# Public HTML verification code from Google Search Console (not a password).
GOOGLE_SITE_VERIFICATION=
DATABASE_URL=postgresql://aidirect:CHANGE_ME@127.0.0.1:55432/aidirect
# Optional direct connection for managed PostgreSQL migrations; blank falls back above.
DATABASE_URL_UNPOOLED=
POSTGRES_PASSWORD=CHANGE_ME
TOKEN_ENCRYPTION_KEY=
PROOF_ADMIN_SECRET=
SESSION_SECRET=
OPERATOR_EMAIL=admin@aidirect.local
OPERATOR_PASSWORD_HASH=
CRON_SECRET=
PRIVACY_CONTACT_EMAIL=
META_WEBHOOK_VERIFY_TOKEN=
# Instagram app ID/secret from Instagram > API setup with Instagram login.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# The webhook signing app secret: verify against an actual signed Meta sample.
META_WEBHOOK_APP_SECRET=
META_API_VERSION=v26.0
# Official private-replies documentation requires these two scopes.
META_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_comments
# Safe default: no real messaging. Change to meta only for the real proof.
META_ADAPTER=simulated
REAL_SEND_ENABLED=false
AUTOMATION_ENABLED=false
# Optional Sendbox provider proof. Never expose these values in the browser bundle.
SENDBOX_API_KEY=
SENDBOX_WEBHOOK_SECRET=
