generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Legacy connection/delivery proof remains single-operator; catalog tenancy is separate.
model ProofConnection {
  id                  String   @id @default("proof")
  accountId           String   @unique
  appScopedId         String
  username            String
  tokenCipher         String
  expiresAt           DateTime
  issuedAt            DateTime @default(now())
  acceptCommentsSince DateTime @default(now())
  status              String   @default("connected")
  subscribed          Boolean  @default(false)
  nextSendAt          DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model ProofRule {
  id        String   @id @default("proof")
  accountId String
  mediaId   String
  keyword   String
  replyText String
  link      String
  enabled   Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

model CommentEvent {
  id         String     @id @default(cuid())
  accountId  String
  commentId  String
  mediaId    String
  source     String
  matched    Boolean
  receivedAt DateTime   @default(now())
  deliveries Delivery[]

  @@unique([accountId, commentId, source])
}

model Delivery {
  id            String       @id @default(cuid())
  eventId       String
  event         CommentEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  accountId     String
  commentId     String
  mediaId       String
  provider      String
  source        String
  replyCipher   String
  status        String       @default("pending")
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  leaseUntil    DateTime?
  leaseToken    String?
  messageId     String?
  errorKind     String?
  errorCode     Int?
  errorSubcode  Int?
  traceId       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  observedAt    DateTime?

  // Global per account/comment/provider, survives disconnect and reconnect.
  @@unique([accountId, commentId, provider])
  @@index([status, nextAttemptAt])
}

model OAuthAttempt {
  stateHash  String   @id
  inviteHash String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model ConnectionInvite {
  tokenHash String    @id
  expiresAt DateTime
  claimedAt DateTime?
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model ProofLoginGuard {
  id            String   @id
  nextAttemptAt DateTime
}

model OperatorSession {
  tokenHash String   @id
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

model WorkerState {
  id         String   @id
  lastSeenAt DateTime
  provider   String
}

// Provider-specific proof stays isolated from the direct Meta adapter.
model SendboxConnection {
  id          String   @id @default("proof")
  accountId   String   @unique
  instagramId String
  username    String
  expiresAt   DateTime
  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Short-lived encrypted evidence; receiving an action result is not proof of delivery.
model SendboxWebhookEvent {
  eventId       String   @id
  accountId     String
  eventType     String
  payloadCipher String?
  receivedAt    DateTime @default(now())
  expiresAt     DateTime

  @@index([expiresAt])
}

// Owner connection grant only; never an operator session or provider credential.
model SendboxInvite {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  claimHash String?
  expiresAt DateTime
  claimedAt DateTime?
  usedAt    DateTime?
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

// Catalog tenancy is independent of the legacy, single-operator connection proof.
model User {
  id          String       @id @default(cuid())
  memberships Membership[]
  createdAt   DateTime     @default(now())
}

model Workspace {
  id          String        @id @default(cuid())
  name        String
  paused      Boolean       @default(false)
  memberships Membership[]
  pages       CatalogPage[]
  createdAt   DateTime      @default(now())
}

enum WorkspaceRole {
  OWNER
  EDITOR
  VIEWER
}

model Membership {
  userId      String
  workspaceId String
  role        WorkspaceRole
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@id([userId, workspaceId])
}

// A manually named catalog page is NOT an authenticated Instagram connection.
model CatalogPage {
  id          String           @id @default(cuid())
  workspaceId String
  name        String
  handle      String
  workspace   Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  products    CatalogProduct[]
  createdAt   DateTime         @default(now())

  @@unique([id, workspaceId])
  @@unique([workspaceId, handle])
}

model CatalogProduct {
  id          String          @id @default(cuid())
  workspaceId String
  pageId      String
  name        String
  description String
  category    String
  priceToman  BigInt
  stock       Int
  active      Boolean         @default(true)
  url         String
  page        CatalogPage     @relation(fields: [pageId, workspaceId], references: [id, workspaceId], onDelete: Cascade)
  posts       MediaProduct[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([id, workspaceId, pageId])
  @@index([workspaceId, pageId, active, priceToman])
}

model MediaProduct {
  id          String         @id @default(cuid())
  workspaceId String
  pageId      String
  productId   String
  permalink   String
  product     CatalogProduct @relation(fields: [productId, workspaceId, pageId], references: [id, workspaceId, pageId], onDelete: Cascade)

  // Manual associations are for preview only until provider ownership is verified.
  @@unique([workspaceId, pageId, productId, permalink])
}

model OperationControl {
  id        String   @id @default("proof")
  paused    Boolean  @default(false)
  updatedAt DateTime @updatedAt
}
